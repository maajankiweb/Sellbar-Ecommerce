# ==============================================================================
# SELBAR PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node / Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://selbar.in

# Backend & API Endpoints
NEXT_PUBLIC_API_BASE_URL=/api/v1

# MongoDB Atlas Database URI (Mandatory)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/selbar_dev?retryWrites=true&w=majority

# Redis Cache, Session, & Rate Limiting (Optional in local dev, Mandatory in production)
REDIS_URL=redis://127.0.0.1:6379

# JWT Cryptographic Secrets (Mandatory - generate via openssl rand -hex 32)
JWT_ACCESS_SECRET=e7c83f9829104fa28db374619a00cd8321049283740192847291038472910283
JWT_REFRESH_SECRET=a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9
JWT_ISSUER=selbar.in
JWT_AUDIENCE=selbar.in
COOKIE_DOMAIN=localhost

# OTP Cryptographic Pepper (Never share or commit production secret)
OTP_HMAC_SECRET=c1f4e8b92a3d7e5f1049283740192847291038472910283e7c83f9829104fa28

# Argon2id Parameter Tuning (OWASP Spec)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting & Account Protection Parameters
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60
ACCOUNT_LOGIN_LIMIT_MAX=5
ACCOUNT_LOGIN_LIMIT_WINDOW=300
OTP_MAX_REQUESTS=3
OTP_WINDOW_SECONDS=900

# Razorpay Payment Gateway (Test Mode / Production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_secret

# SMS Gateway (Fast2SMS / MSG91)
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Email SMTP Notification Engine
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=auth@selbar.in
SMTP_PASS=
SMTP_FROM="SELBAR Security" <auth@selbar.in>

# Cloud Object Storage (AWS S3 / Cloudflare R2)
AWS_S3_BUCKET=selbar-assets-dev
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
