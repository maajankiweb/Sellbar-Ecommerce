# ==============================================================================
# SELBAR ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Do NOT commit actual values or secrets to this file or git history.
# Copy this file to .env.local for local development.
# ==============================================================================

# 1. Database (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=

# 2. Authentication & Cryptography (Generate via `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HMAC_SECRET=

# 3. Super Administrator Seed Credentials (Used by `npm run seed:admin`)
ADMIN_EMAIL=admin@selbar.in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 4. Payment Gateway (Razorpay - Use Test Keys for dev, Live Keys for prod)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 5. Logistics & Doorstep Fulfillment (Shiprocket)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# 6. SMS Gateway (MSG91 / Fast2SMS)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
FAST2SMS_API_KEY=

# 7. Transactional Email (Resend / SMTP)
RESEND_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SELBAR" <notifications@selbar.in>

# 8. Media & Cloud Storage (Cloudinary / Cloudflare R2 / AWS S3)
CLOUDINARY_URL=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 9. Observability & Error Monitoring (Sentry)
SENTRY_DSN=

# 10. Application Runtime & Cache (Redis)
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
